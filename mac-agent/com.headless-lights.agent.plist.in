<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.headless-lights.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Library/Application Support/headless-lights/bin/headless-lights-agent</string>
        <string>--effect</string>
        <string>stranger-things</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Application Support/headless-lights/agent.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Application Support/headless-lights/agent.error.log</string>
</dict>
</plist>
